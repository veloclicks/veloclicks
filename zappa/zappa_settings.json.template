{
    "dev": {
        "app_function": "app.__init__.application",
        "aws_region": "eu-west-2",
        "project_name": "veloclicks",
        "runtime": "python3.11",
        "s3_bucket": "veloclicks-zappa-deployments-eu-west-2",
        "django_settings": null,
        "environment_variables": {
            "FLASK_APP": "__init__:create_app",
            "FLASK_ENV": "production",
            "SKIP_CELERY": "true"
        },
        "keep_warm": false,
        "memory_size": 512,
        "timeout_seconds": 30,
        "exclude": ["*.pyc", "__pycache__"],
        "include": ["../flask/"]
    },
    "production": {
        "app_function": "app.__init__.application",
        "aws_region": "eu-west-2",
