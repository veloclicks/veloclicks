{
    "dev": {
        "app_function": "app.__init__.create_app",
        "aws_region": "eu-west-1",
        "project_name": "veloclicks",
        "runtime": "python3.11",
        "s3_bucket": "veloclicks-zappa-deployments-eu",
        "django_settings": null,
        "environment_variables": {
            "FLASK_APP": "__init__:create_app",
            "FLASK_ENV": "production"
        },
        "keep_warm": false,
        "memory_size": 512,
        "timeout_seconds": 30,
        "exclude": ["*.pyc", "__pycache__"],
        "include": ["../flask/"]
    },
    "production": {
        "app_function": "app.__init__.create_app",
        "aws_region": "eu-west-1",
        "project_name": "veloclicks",
        "runtime": "python3.11",
        "s3_bucket": "veloclicks-zappa-deployments-eu",
        "django_settings": null,
        "environment_variables": {
            "FLASK_APP": "__init__:create_app",
            "FLASK_ENV": "production"
        },
        "keep_warm": false,
        "memory_size": 512,
        "timeout_seconds": 30,
        "exclude": ["*.pyc", "__pycache__"],
        "include": ["../flask/"]
    }
}